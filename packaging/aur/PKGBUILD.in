# Maintainer: Aleksandr Oreshkin <alex@cyberbrand.net>
pkgname=whodis
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Domain workstation with RDAP, WHOIS, RWhois, DNS, and diagnostics'
arch=('x86_64' 'aarch64')
url='https://github.com/Alex9001/whodis'
license=('MIT')
depends=('glibc')
makedepends=('git' 'go')
options=('!lto')
source=("${pkgname}_${pkgver}_source.tar.gz::${url}/releases/download/v${pkgver}/${pkgname}_${pkgver}_source.tar.gz")
sha256sums=('@SHA256@')

prepare() {
  cd "${pkgname}_${pkgver}"
  go mod download
}

build() {
  cd "${pkgname}_${pkgver}"

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw -buildvcs=false'

  go build \
    -ldflags="-linkmode=external -X main.version=${pkgver}" \
    -o whodis \
    ./cmd/whodis
}

check() {
  cd "${pkgname}_${pkgver}"
  go test ./...
}

package() {
  cd "${pkgname}_${pkgver}"
  install -Dm755 whodis "${pkgdir}/usr/bin/whodis"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  scripts/collect-go-licenses.sh "${pkgdir}/usr/share/licenses/${pkgname}/third-party"
}

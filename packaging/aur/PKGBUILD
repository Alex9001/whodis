pkgname=whodis
pkgver=0.1.0
pkgrel=1
pkgdesc='Modern WHOIS alternative with automatic RDAP routing and structured output'
arch=('x86_64')
url='https://github.com/Alex9001/whodis'
license=('MIT')
depends=('glibc')
makedepends=('git' 'go')
options=('!lto')
source=("${pkgname}_${pkgver}_source.tar.gz::${url}/releases/download/v${pkgver}/${pkgname}_${pkgver}_source.tar.gz")
sha256sums=('04c41acac76a57d572b077645b72c8f76d6dc7a3073411cb99e9bdeaf9f45c1d')

prepare() {
  cd "${pkgname}_${pkgver}"
  go mod download
}

build() {
  cd "${pkgname}_${pkgver}"

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw -buildvcs=false'

  go build \
    -ldflags="-linkmode=external -X main.version=${pkgver}" \
    -o whodis \
    ./cmd/whodis
}

check() {
  cd "${pkgname}_${pkgver}"
  go test ./...
}

package() {
  cd "${pkgname}_${pkgver}"
  install -Dm755 whodis "${pkgdir}/usr/bin/whodis"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
